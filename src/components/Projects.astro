---
const research = [
  {
    title: "Diabetes classification, CCHS 2022",
    when: "2026 · guided by Prof. Nisha Vanjari",
    question: "Does the choice of predictors matter more than the choice of model?",
    points: [
      "Prepared 67,079 survey responses across 255 variables, handling the survey's special answer codes one variable at a time.",
      "Compared Logistic Regression, Random Forest and Gradient Boosting with 5-fold cross-validation and a fresh holdout.",
    ],
    stat: "0.774 to 0.827",
    statLabel: "ROC-AUC, just from better predictors",
    img: "/img/work/cchs-dashboard.webp",
    w: 1200, h: 732,
    links: [
      { label: "Dashboard", href: "https://cchs-2022-diabetes-ml.streamlit.app/?page=Overview" },
      { label: "Code", href: "https://github.com/peeyusha06/cchs-2022-diabetes-ml" },
    ],
  },
  {
    title: "Predicting Toronto restaurant inspections",
    when: "2026 · DineSafe, guided by Prof. Nisha Vanjari",
    question: "How much does a restaurant's inspection history help predict its next result?",
    points: [
      "Rebuilt 115,899 raw rows into 77,475 inspections, using only information available before each one.",
      "CatBoost with SHAP and calibration checks; reported honestly as a risk-ranking tool.",
    ],
    stat: "28%",
    statLabel: "of all non-pass results sat in the top 10% the model flagged",
    img: "/img/work/dinesafe-dashboard.webp",
    w: 1200, h: 950,
    links: [
      { label: "Dashboard", href: "https://toronto-dinesafe-ml.streamlit.app/" },
      { label: "Code", href: "https://github.com/peeyusha06/toronto-dinesafe-ml" },
    ],
  },
  {
    title: "El Niño drought vulnerability index",
    when: "2026, ongoing · minor project, Prof. Pankaj Deshmukh",
    question: "Which Maharashtra districts are most exposed when El Niño hits the monsoon?",
    points: [
      "75 years of IMD gridded rainfall for all 34 districts, with El Niño years marked using NOAA's RONI index.",
      "Six indicators weighted with PCA into a 0 to 100 index, with district maps and a Streamlit explorer.",
    ],
    stat: "34",
    statLabel: "districts, 1950 to 2024 rainfall",
    img: null,
    w: 0, h: 0,
    links: [],
  },
];

const builds = [
  { name: "TruthLens AI", what: "Deepfake image detector", detail: "React, Node API and a Python FastAPI service running a three-layer cascade: Hive AI, a HuggingFace ViT model, then a statistical fallback. Gemini explains every result in plain words.", stack: ["React", "Node", "FastAPI", "MongoDB", "HuggingFace", "Gemini"], href: "https://github.com/peeyusha06/truthlens-ai" },
  { name: "HelpIndia", what: "Volunteer and donation platform for NGOs", detail: "Relational schema designed from scratch, SQL views for the dashboard and row-level security so every user only sees their own data.", stack: ["React", "TypeScript", "Supabase", "PostgreSQL"], href: "https://github.com/peeyusha06/helpindia" },
  { name: "VitaMind", what: "AI health and nutrition tracker", detail: "Nutrition trend dashboards over custom date ranges, calendar history, streaks and trend calculations.", stack: ["React", "TypeScript", "Supabase", "Recharts"], href: "https://github.com/peeyusha06/vitamind-ai-wellness" },
];
---
<section class="section" id="work">
  <div class="wrap">
    <h2 class="display section-title" data-split>Research I'm <em>proud of</em></h2>
    <p class="lede" data-reveal>Real public data, careful evaluation, and results I can explain to anyone.</p>
  </div>

  <div class="stack wrap">
    {research.map((p, i) => (
      <article class="card" data-card>
        <span class="shade" aria-hidden="true" data-shade></span>
        <div class="card-copy">
          <p class="when">{p.when}</p>
          <h3 class="display">{p.title}</h3>
          <p class="question">{p.question}</p>
          <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
          {p.links.length > 0 && (
            <div class="links">{p.links.map((l) => <a class="btn btn-line" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}</div>
          )}
        </div>
        <div class="card-visual">
          {p.img ? (
            <img src={p.img} width={p.w} height={p.h} alt={`Screenshot of the ${p.title} dashboard`} loading="lazy" />
          ) : null}
          <div class={p.img ? "stat" : "stat stat-solo"}>
            <span class="display" data-count={/^[\d.,]+%?$/.test(p.stat) ? "" : undefined}>{p.stat}</span>
            <small>{p.statLabel}</small>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="wrap builds">
    <h3 class="display builds-title" data-split>Things I've <em>shipped</em></h3>
    <ul class="rows">
      {builds.map((b) => (
        <li>
          <a class="row" href={b.href} target="_blank" rel="noopener">
            <span class="row-name display">{b.name}</span>
            <span class="row-what">{b.what}</span>
            <span class="row-detail">{b.detail}</span>
            <span class="row-stack">{b.stack.map((s) => <span class="tag">{s}</span>)}</span>
            <span class="row-arrow" aria-hidden="true">&#8599;</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="note">Built fast with AI-assisted tools (Cursor, Claude, Lovable), debugged and understood by me.</p>
  </div>
</section>

<style>
  .stack { margin-top: clamp(40px, 6vw, 80px); display: grid; gap: 28px; }
  .card {
    position: sticky; top: 88px;
    display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(20px, 3vw, 48px);
    padding: clamp(22px, 3.2vw, 48px);
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--wine-700), var(--wine-800) 55%);
    border: 1px solid rgb(232 163 176 / .14);
    box-shadow: 0 -20px 60px rgb(10 0 3 / .45);
    transform-origin: 50% 0;
    overflow: hidden;
  }
  .shade { position: absolute; inset: 0; background: var(--wine-950); opacity: 0; pointer-events: none; z-index: 2; }
  .card:nth-child(2) { background: linear-gradient(160deg, #651a2b, #350a14 60%); }
  .card:nth-child(3) { background: linear-gradient(160deg, #7a2134, #3d0b16 60%); }
  .when { font-size: 13px; color: var(--rose); letter-spacing: .04em; }
  h3 { font-size: clamp(28px, 3.4vw, 48px); margin-top: 10px; line-height: 1.05; color: var(--cream); }
  .question { margin-top: 14px; font-style: italic; color: var(--blush); }
  ul { margin-top: 16px; padding-left: 1.1em; color: var(--blush-dim); display: grid; gap: 8px; font-size: .95em; }
  .links { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
  .card-visual { display: grid; gap: 16px; align-content: start; }
  .card-visual img { border-radius: 8px; border: 1px solid rgb(255 255 255 / .08); box-shadow: 0 18px 40px rgb(10 0 3 / .4); }
  .stat { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .stat span { font-size: clamp(40px, 5vw, 72px); color: var(--rose); line-height: 1; }
  .stat small { color: var(--blush-dim); max-width: 26ch; font-size: 14px; }
  .stat-solo { flex-direction: column; justify-content: center; height: 100%; min-height: 260px; padding: 24px; border-radius: 10px; background: rgb(232 163 176 / .07); border: 1px dashed rgb(232 163 176 / .35); }
  .stat-solo span { font-size: clamp(96px, 12vw, 180px); }

  .builds { margin-top: clamp(80px, 10vw, 140px); }
  .builds-title { font-size: clamp(34px, 5vw, 72px); }
  .builds-title em { color: var(--rose); }
  .rows { list-style: none; padding: 0; margin-top: 28px; border-top: 1px solid rgb(232 163 176 / .2); }
  .row {
    display: grid; grid-template-columns: 1.1fr 1fr 2fr auto; gap: 8px 28px; align-items: baseline;
    padding: 28px 8px; text-decoration: none;
    border-bottom: 1px solid rgb(232 163 176 / .2);
    transition: background var(--dur-quick) var(--ease-out), padding var(--dur-base) var(--ease-out);
  }
  .row-name { font-size: clamp(26px, 2.6vw, 38px); color: var(--cream); }
  .row-what { color: var(--rose); }
  .row-detail { color: var(--blush-dim); font-size: .92em; }
  .row-stack { grid-column: 3; display: flex; gap: 6px; flex-wrap: wrap; }
  .row-arrow { grid-row: 1; grid-column: 4; font-size: 28px; color: var(--rose); transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) {
    .row:hover { background: rgb(232 163 176 / .06); padding-left: 20px; }
    .row:hover .row-arrow { transform: translate(4px, -4px); }
  }
  .note { margin-top: 18px; font-size: 14px; color: var(--blush-dim); }

  @media (max-width: 900px) {
    .card { grid-template-columns: 1fr; position: relative; top: 0; }
    .row { grid-template-columns: 1fr auto; }
    .row-what, .row-detail, .row-stack { grid-column: 1 / -1; }
    .row-arrow { grid-column: 2; }
  }
</style>
